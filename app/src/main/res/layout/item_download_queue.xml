<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_countdown_pill"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:srcCompat="@drawable/ic_download_24"
            app:tint="?attr/colorPrimary"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/itemDownloadQueueTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            tools:text="Kashita Maryoku wa Revo Barai" />

        <ImageView
            android:id="@+id/itemDownloadQueueCancel"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            app:srcCompat="@drawable/ic_round_close_24"
            app:tint="?attr/colorOnBackground"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <TextView
        android:id="@+id/itemDownloadQueueEpisode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="2dp"
        android:alpha="0.6"
        android:textSize="12sp"
        tools:text="Episode 8" />

    <ProgressBar
        android:id="@+id/itemDownloadQueueProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progressTint="?attr/colorPrimary"
        android:progressBackgroundTint="#33FFFFFF"
        tools:progress="45" />

    <TextView
        android:id="@+id/itemDownloadQueueStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0.7"
        android:textSize="12sp"
        tools:text="Downloading 45%" />

</LinearLayout>
